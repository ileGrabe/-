---
layout: default
---

<div class="single-post">
    <div class="single-post-header">
        <span class="post-date">{{ page.date | date: "%b %d, %Y" }}</span>
        <h1 class="single-post-title">{{ page.title }}</h1>
    </div>
    <div class="single-post-content">
        {{ content }}
    </div>
</div>
